import os
from ProfileManager import ProfileManager
from ErrorLogManager import ErrorLogManager
import serializacion # Tu archivo con funciones de guardado/carga

def limpiar_pantalla():
    os.system('cls' if os.name == 'nt' else 'clear')

def mostrar_cabecera(titulo):
    print("\n" + "="*60)
    print(f"{titulo:^60}")
    print("="*60)

def main():
    manager = ProfileManager()
    logger = ErrorLogManager()
    bot_actual = None
    
    serializacion.cargar_datos(manager)

    while True:
        mostrar_cabecera("GEMINI MESH - SISTEMA DE ORQUESTACIÓN")
        status = bot_actual.botName if bot_actual else "Ninguno"
        print(f"ESTADO ACTUAL: [Bot Seleccionado: {status}]")
        print("-" * 60)
        print("COMANDOS: list | select <id> | chat \"<msj>\" | edit <nombre/model/prompt>")
        print("          undo | delete <id> | current | log | save | exit")
        print("-" * 60)

        try:
            linea = input(">> ").strip()
            if not linea: continue
            
            partes = linea.split(" ", 1)
            cmd = partes[0].lower()
            arg = partes[1] if len(partes) > 1 else None

            if cmd == "list":
                print("\nLISTADO DE PERFILES:")
                for bot in manager: # Usa el __iter__ de tu ProfileManager
                    print(f"[{bot.id}] {bot.botName} - Modelo: {bot.model}")

            elif cmd == "select":
                if not arg:
                    print("Error: Indique el ID del bot.")
                else:
                    bot_actual = manager.consultProfile(arg)
                    if not bot_actual:
                        logger.logError(404, f"ID de bot '{arg}' no encontrado.")
                        print("Error: ID no encontrado.")

            elif cmd == "chat":
                if not bot_actual:
                    print("Error: Seleccione un bot primero.")
                elif not arg:
                    print("Error: El mensaje no puede estar vacío.")
                else:
                    mensaje = arg.strip('"')
                    bot_actual.messageQueue.enqueue("Usuario", mensaje)
                    # Simulación de respuesta de API Gemini
                    respuesta_simulada = "Hola, soy tu asistente Gemini configurado."
                    bot_actual.messageQueue.enqueue("Gemini", respuesta_simulada)
                    print(f"\n{bot_actual.botName}: {respuesta_simulada}")

            elif cmd == "edit":
                if not bot_actual:
                    print("Error: Seleccione un bot.")
                else:
                    bot_actual.undoStack.push(bot_actual.model, bot_actual.systemInstruction)
                    nuevo_prompt = input("Ingrese nueva System Instruction: ")
                    bot_actual.systemInstruction = nuevo_prompt
                    print("Bot actualizado. Estado previo guardado en la Pila.")

            elif cmd == "undo":
                if not bot_actual:
                    print("Error: Seleccione un bot.")
                else:
                    estado_previo = bot_actual.undoStack.pop()
                    if estado_previo:
                        bot_actual.model = estado_previo.model
                        bot_actual.systemInstruction = estado_previo.systemInstruction
                        print("Restauración exitosa del estado anterior.")
                    else:
                        print("No hay estados previos para este bot.")

            elif cmd == "log":
                print("\nLOG DE ERRORES DEL SISTEMA:")
                logger.showErrors()

            # 5. PERSISTENCIA (Módulo 4)[cite: 1]
            elif cmd == "save":
                serializacion.serializar(manager, serializacion.obtener_ruta())
                print("Todos los datos han sido persistidos en JSON.")

            elif cmd == "current":
                if bot_actual:
                    print(f"\nCONFIGURACIÓN DE: {bot_actual.botName}")
                    print(f"Modelo: {bot_actual.model}")
                    print(f"Instrucción Base: {bot_actual.systemInstruction}")
                    print("-" * 20)
                    temp = bot_actual.messageQueue.first
                    while temp:
                        print(f"[{temp.user}]: {temp.text}")
                        temp = temp.next
                else:
                    print("No hay bot seleccionado.")

            elif cmd == "exit":
                print("Finalizando sesión y liberando memoria...")
                break

            else:
                print(f"Comando '{cmd}' no reconocido.")

        except ValueError:
            logger.logError(102, "Error en tipo de dato ingresado.")
            print("Error: Formato de entrada inválido.")
        except Exception as e:
            logger.logError(500, f"Error inesperado en interfaz: {str(e)}")
            print(f"Ocurrió un error crítico: {e}")

if __name__ == "__main__":
    main()
