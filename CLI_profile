from ProfileManager import ProfileManager
from serialization import serializar, obtener_ruta
from deserialization import cargar_datos

class AppCLI:
    def __init__(self):
        self.profile_manager = ProfileManager()
        self.selected_node = None
        
        self.comandos = {
            "create": self.cmd_create,
            "list": self.cmd_list,
            "select": self.cmd_select,
            "chat": self.cmd_chat,
            "edit": self.cmd_edit,
            "delete": self.cmd_delete,
            "undo": self.cmd_undo,
            "current": self.cmd_current,
            "log": self.cmd_log,
            "save": self.cmd_save,
            "load": self.cmd_load,
            "help": self.cmd_help
        }

    def run(self):
        print("------ INICIANDO GEMINI MESH ------")
        print("Escribe 'help' para ver los comandos.")
        
        while True:
            bot_actual = self.selected_node.botName if self.selected_node else "Ninguno"
            entrada = input(f"\n[Bot: {bot_actual}]> ").strip()
            
            if not entrada:
                continue

            if entrada.lower() == "exit" or entrada.lower() == "exit-chatbot":
                break

            partes = entrada.split(maxsplit=1)
            comando = partes[0].lower()
            argumentos = partes[1] if len(partes) > 1 else ""

            if comando in self.comandos:
                try:
                    self.comandos[comando](argumentos)
                except Exception as e:
                    print(f"Error ejecutando '{comando}': {e}")
                    self.profile_manager.logger.logError(500, f"Error en CLI {comando}: {str(e)}")
            else:
                print("Comando no reconocido.")

    def cmd_help(self, args):
        print(" create              : Crea un nuevo perfil")
        print(" list                : Muestra todos los bots")
        print(" select <id>         : Selecciona un bot")
        print(" chat \"<msj>\"        : Envia un mensaje")
        print(" edit <campo> <valor>: Modifica nombre, modelo o prompt")
        print(" delete <id>         : Elimina un bot")
        print(" undo                : Restaura la configuracion")
        print(" current             : Muestra el contexto")
        print(" save                : Guarda en JSON")
        print(" load                : Carga desde JSON")
        print(" log                 : Muestra los errores")
        print(" exit / exit-chatbot : Cierra el programa")

    def cmd_create(self, args):
        b = input("Nombre del bot: ")
        m = input("Modelo: ")
        k = input("ApiKey: ")
        si = input("Prompt: ")
        pid = self.profile_manager.createProfile(b, m, k, si)
        print(f"Perfil creado con ID: {pid}")

    def cmd_list(self, args):
        hay_bots = False
        for node in self.profile_manager:
            hay_bots = True
            print(f"ID: {node.id} Nombre: {node.botName} Modelo: {node.model}")
        if not hay_bots:
            print("No hay bots registrados.")

    def cmd_select(self, args):
        if not args:
            print("Debes indicar un ID.")
            return
        
        node = self.profile_manager.consultProfile(args)
        if node:
            self.selected_node = node
            print(f"Bot '{node.botName}' seleccionado.")
        else:
            print("Bot no encontrado.")

    def cmd_chat(self, args):
        if not self.selected_node:
            print("Debes seleccionar un bot primero.")
            return
        if not args:
            print("Falta el mensaje.")
            return
        
        mensaje = args.strip('"').strip("'")
        usuario = "User"
        self.selected_node.messageQueue.enqueue(usuario, mensaje)
        print("Mensaje encolado.")

    def cmd_edit(self, args):
        if not self.selected_node:
            print("Debes seleccionar un bot primero.")
            return
        
        partes = args.split(maxsplit=1)
        if len(partes) < 2:
            print("Formato incorrecto.")
            return
            
        campo = partes[0].lower()
        valor = partes[1].strip('"').strip("'")
        
        if campo == "nombre":
            self.profile_manager.modifyProfile(self.selected_node.id, newName=valor)
        elif campo == "modelo":
            self.profile_manager.modifyProfile(self.selected_node.id, newModel=valor)
        elif campo == "prompt":
            self.profile_manager.modifyProfile(self.selected_node.id, newPrompt=valor)
        else:
            print("Campo no valido.")
            return
            
        print("Campo actualizado.")

    def cmd_delete(self, args):
        if not args:
            print("Debes indicar un ID.")
            return
            
        if self.profile_manager.deleteProfile(args):
            print(f"Bot {args} eliminado.")
            if self.selected_node and self.selected_node.id == args:
                self.selected_node = None
        else:
            print("No se encontro ese perfil.")

    def cmd_undo(self, args):
        if not self.selected_node:
            print("Debes seleccionar un bot primero.")
            return
            
        popped = self.selected_node.undoStack.pop()
        if popped:
            self.selected_node.model = popped.model
            self.selected_node.systemInstruction = popped.systemInstruction
            print("Configuracion restaurada.")
        else:
            print("La pila esta vacia.")

    def cmd_current(self, args):
        if not self.selected_node:
            print("Debes seleccionar un bot primero.")
            return
            
        print(f"Modelo: {self.selected_node.model}")
        print(f"Instruccion: {self.selected_node.systemInstruction}")
        print("Mensajes:")
        
        actual_msg = self.selected_node.messageQueue.first
        if not actual_msg:
            print("No hay mensajes.")
        while actual_msg:
            print(f"[{actual_msg.user}]: {actual_msg.text}")
            actual_msg = actual_msg.next

    def cmd_log(self, args):
        self.profile_manager.logger.showErrors()

    def cmd_save(self, args):
        serializar(self.profile_manager, obtener_ruta())

    def cmd_load(self, args):
        cargar_datos(self.profile_manager)
        print("Datos cargados.")

if __name__ == "__main__":
    app = AppCLI()
    app.run()