from ProfileManager import ProfileManager
from ErrorLogManager import ErrorLogManager
from serialization import serializar, obtener_ruta
from deserialization import cargar_datos
from TDA import Cola
from StackManager import StackManager

def imprimir_perfil(node):
    print(f"ID: {node.id}\n  Nombre: {node.botName}\n  Modelo: {node.model}\n  ApiKey: {node.apiKey}\n  Prompt: {node.systemInstruction}")

def main():
    profile_manager = ProfileManager()
    error_manager = ErrorLogManager()
    cola = None
    pila = None

    while True:
        print("\n------ MENÚ PRINCIPAL ------")
        print("1. Crear perfil")
        print("2. Consultar perfil")
        print("3. Modificar perfil")
        print("4. Eliminar perfil")
        print("5. Listar perfiles")
        print("6. Enviar mensaje a cola")
        print("7. Apilar estado (guardar modelo/prompt)")
        print("8. Desapilar estado")
        print("9. Guardar en JSON")
        print("10. Cargar desde JSON")
        print("11. Ver errores")
        print("0. Salir")
        opcion = input("Escoge opción: ").strip()

        if opcion == "1":
            b = input("Nombre del bot: ")
            m = input("Modelo: ")
            k = input("ApiKey: ")
            si = input("Prompt/System Instruction: ")
            pid = profile_manager.createProfile(b, m, k, si)
            print(f"Perfil creado con ID: {pid}")

        elif opcion == "2":
            pid = input("ID a consultar: ")
            node = profile_manager.consultProfile(pid)
            if node:
                imprimir_perfil(node)
            else:
                print("Perfil no encontrado.")

        elif opcion == "3":
            pid = input("ID a modificar: ")
            node = profile_manager.consultProfile(pid)
            if node:
                new_name = input(f"Nuevo nombre (deja vacío para '{node.botName}'): ") or None
                new_model = input(f"Nuevo modelo (deja vacío para '{node.model}'): ") or None
                new_prompt = input(f"Nuevo prompt (deja vacío para '{node.systemInstruction}'): ") or None
                ok = profile_manager.modifyProfile(pid, new_name, new_model, new_prompt)
                print("Perfil modificado." if ok else "No se pudo modificar.")
            else:
                print("Perfil no encontrado.")

        elif opcion == "4":
            pid = input("ID a eliminar: ")
            ok = profile_manager.deleteProfile(pid)
            print("Eliminado." if ok else "No se encontró ese perfil.")

        elif opcion == "5":
            for node in profile_manager:
                imprimir_perfil(node)

        elif opcion == "6":
            # Este ejemplo asume que hay solo una cola global. Puedes relacionarla con un node específico si quieres.
            if cola is None:
                max_size = int(input("Tamaño máximo de cola: "))
                cola = Cola(max_size)
            user = input("Usuario remitente: ")
            text = input("Mensaje: ")
            cola.enqueue(user, text)
            print("Mensaje encolado.")

        elif opcion == "7":
            # Este ejemplo asume que hay una pila por sistema, puedes asociarla a node si lo prefieres
            if pila is None:
                pila = StackManager()
            model = input("Modelo a guardar: ")
            prompt = input("Prompt a guardar: ")
            pila.push(model, prompt)
            print("Estado guardado en pila.")

        elif opcion == "8":
            if pila is not None:
                popped = pila.pop()
                if popped:
                    print(f"Desapilado: Modelo='{popped.model}', Prompt='{popped.systemInstruction}'")
                else:
                    print("La pila está vacía.")
            else:
                print("La pila aún no ha sido creada.")

        elif opcion == "9":
            ruta = obtener_ruta()
            serializar(profile_manager, ruta)

        elif opcion == "10":
            cargar_datos(profile_manager)
            print("Datos cargados.")

        elif opcion == "11":
            error_manager.showErrors()

        elif opcion == "0":
            print("Saliendo...")
            break

        else:
            print("Opción no válida. Intenta de nuevo.")

if __name__ == "__main__":
    main()
